# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" de verdade (ele já deve estar no .gitignore).

# Porta em que o servidor vai rodar
PORT=3000

# Senha de acesso da Área da Equipe (login do painel admin)
ADMIN_SENHA=troque-esta-senha

# Segredo usado para assinar os tokens de login (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa
