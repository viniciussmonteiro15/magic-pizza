# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" de verdade (ele já está no .gitignore).

# Porta em que o servidor vai rodar
PORT=3000

# Hash bcrypt da senha de acesso da Área da Equipe.
# NÃO coloque a senha em texto puro aqui — gere o hash com:
#   npm run gerar-senha "sua-senha-aqui"
# e cole o resultado abaixo.
ADMIN_SENHA_HASH=$2b$10$sHwsw1J.eoDGYyyqxYeiGuI/zXMD26vdjJwAuR3bGdNdOvYdRqPrW


# Segredo usado para assinar os tokens de login (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa
